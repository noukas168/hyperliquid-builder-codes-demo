# WalletConnect project ID — get one free at https://dashboard.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Dwellir API key — get one at https://dashboard.dwellir.com
# Used for mainnet info queries (higher rate limits than public endpoints).
#
# WARNING: the NEXT_PUBLIC_ prefix ships this value to the browser. Dwellir
# embeds the key in the URL path (src/config/constants.ts builds
# .../{key}/info and .../{key}/ws), so anyone who loads the page can read it
# out of the bundle or the network tab and reuse it.
#
# This is NOT the "publishable key" pattern. As of 2026-08-07 Dwellir's own
# docs show no domain, origin, referrer, or IP restriction for a key: the CLI
# exposes only --name, --daily-quota and --monthly-quota plus enable/disable
# (https://www.dwellir.com/docs/cli/api-keys). A leaked key is therefore
# usable by anyone from anywhere until you disable it, and the only damage
# limit is the quota you set on it.
#
# Leave it unset unless you accept that. Unset is safe: constants.ts falls
# back to the public Hyperliquid endpoints. If you do need the higher limits
# in production, proxy it through a server route the way ZEROX_API_KEY is
# handled below, and set a daily quota on the key as a backstop.
NEXT_PUBLIC_DWELLIR_API_KEY=your_dwellir_api_key_here

# Builder address — the address that receives builder fees
# Defaults to Dwellir's builder address if not set
NEXT_PUBLIC_BUILDER_ADDRESS=0xE94D5a0a377Afe26a461e8aAC2c7189D2006c8b9

# Builder fee in tenths-of-a-basis-point (10 = 1 bps = 0.01%)
# Defaults to 10 if not set
NEXT_PUBLIC_BUILDER_FEE=10

# 0x Swap API key — get one at https://dashboard.0x.org
# SERVER-ONLY. No NEXT_PUBLIC_ prefix: this must never reach the browser.
ZEROX_API_KEY=your_0x_api_key_here

# Address that receives the Basis swap fee
ZEROX_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Basis swap fee in basis points: 100 bps = 1%. 0x caps this at 1000 (10%).
# Applied as swapFeeBps on every quote and always denominated in the sellToken.
ZEROX_FEE_BPS=100

# GoPlus Token Security access token — OPTIONAL.
# Sent as "Authorization: Bearer <token>", matching the official GoPlus SDKs.
# Note: this is NOT a self-serve key. GoPlus documents the API as free at
# 30 calls/minute and says to contact them to apply for a token
# (https://docs.gopluslabs.io/reference/support), so leaving this blank is the
# normal case. Unauthenticated, the limit is reached after roughly ten calls
# in quick succession; the server-side cache in src/lib/goplus.ts is what
# keeps a browsing session under it.
# SERVER-ONLY. No NEXT_PUBLIC_ prefix: this must never reach the browser.
GOPLUS_ACCESS_TOKEN=

# Verbose GoPlus request tracing — logs each call's HTTP status and a 400-char
# prefix of the response body. Off unless set to 1 or true. Failures (rate
# limits, unexpected codes) are logged either way, without the body.
GOPLUS_DEBUG=
